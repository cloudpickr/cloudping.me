{
  "git": {
    "deploymentEnabled": {
      "status": false
    }
  },
  "headers": [
    {
      "source": "/images/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "src/pages/api/probe.ts": {
      "maxDuration": 300
    }
  }
}
