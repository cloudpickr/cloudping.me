# Production site only. Set these in the Vercel project, not in the repo.
# NEXT_PUBLIC_SITE_URL=https://cloudping.me
# NEXT_PUBLIC_GA_ID=G-XXXXXXXX
# NEXT_PUBLIC_SITE_TELEMETRY=1
# NEXT_PUBLIC_HEALTH_JSON_URL=https://<store-id>.public.blob.vercel-storage.com/latest.json  # Vercel Blob (prod); unset falls back to the GitHub status branch raw URL
# NEXT_PUBLIC_STATUS_ORIGIN_HISTORY_BASE=https://raw.githubusercontent.com/<owner>/<repo>/status/h  # optional compact per-origin history override
# PROBE_SECRET=  # server-only; GitHub Actions sends this to POST /api/probe
# PROBE_SECRET_PREV=  # optional previous value; origins accept both during rotation

# GitHub Actions Secrets (Settings > Secrets and variables > Actions)
# PROBE_URL=https://cloudping.me/api/probe
# PROBE_URL_AWS_ICN=https://xxxxxxxxxx.lambda-url.ap-northeast-2.on.aws/
# PROBE_SECRET=
# PROBE_SECRET_PREV=
# BLOB_READ_WRITE_TOKEN=  # vercel_blob_rw_...; lets the probe mirror latest.json to Vercel Blob (absent = git status branch only)

# GitHub Actions Variables (Settings > Secrets and variables > Actions > Variables — not secret)
# AWS_PROBE_ROLE_ARN=arn:aws:iam::<acct>:role/cloudping-probe-invoker  # OIDC role; empty = skip AWS invoke origins
# AWS_PROBE_REGIONS=us-east-1 eu-central-1 ap-southeast-1  # space-separated; invoked via `aws lambda invoke` (no Function URL)
# AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_SUBSCRIPTION_ID  # OIDC identity for .github/workflows/deploy-azure.yml (azure/oidc-setup.sh); not secret on their own

# Probe Lambda (lambda/handler.ts). Deploy to any region with lambda/deploy.sh.
# PROBE_ORIGIN_ID / PROBE_ORIGIN_LABEL are optional — resolveOrigin() derives aws-<region> from AWS_REGION.
# PROBE_ORIGIN_ID=aws-ap-northeast-2
# PROBE_ORIGIN_LABEL="AWS Lambda (ap-northeast-2)"
# PROBE_SECRET=
# PROBE_SECRET_PREV=

# AWS CI/CD (.github/workflows/deploy-aws.yml): OIDC-authenticated GitHub
# Actions (role cloudping-deployer, trusted only for pushes to main, scoped to
# lambda:UpdateFunctionCode/GetFunction* on the 13 cloudping-probe function
# ARNs) bundles handler.ts once and fans update-function-code out to all 13
# Lambda regions on push to main touching lambda/**, src/fns/**, src/data/**.
# Deploys code only — never touches env vars/Function URL, so PROBE_SECRET and
# the Seoul Function URL set by lambda/deploy.sh are preserved.

# Azure CI/CD (azure/oidc-setup.sh, run once): GitHub Actions
# (.github/workflows/deploy-azure.yml) deploys azure/server.ts to all 7 F1 apps
# on push to main touching azure/**, src/fns/**, src/data/**, via OIDC
# (federated Azure AD app, "Website Contributor" scoped to the cloudping-probe
# resource group only — no secrets, no plan/app creation rights).

# Clock Lambda (lambda/clock.mjs, EventBridge 30-minute trigger)
# GITHUB_DISPATCH_TOKEN=  # fine-grained PAT (Actions: write)
# GITHUB_REPO=cloudpickr/cloudping.me  # optional
# GITHUB_WORKFLOW=probe.yml  # optional
# GITHUB_REF=main  # optional

